# Optional — defaults to 5000
PORT=5000

# From the Twilio Console dashboard (console.twilio.com) — needed to download
# MMS media, since Twilio media URLs require Basic Auth with these values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The exact public URL Twilio POSTs to, e.g. https://example.com/sms — the request
# signature is computed over it, so a trailing slash or the wrong scheme rejects
# everything. Leave blank for local dev and the request's own URL is used.
TWILIO_WEBHOOK_URL=

# Only needed on Mark's server (docker-compose.yml) — from the Cloudflare Zero
# Trust dashboard when creating the named tunnel. Not used for local dev.
TUNNEL_TOKEN=
